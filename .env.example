# Credentials are NEVER read from this file.
# boto3 uses the default chain: AWS_PROFILE / env vars / SSO / instance role.

AWS_REGION=ap-south-1

# Bedrock ---------------------------------------------------------------
# Nothing here is vendor-specific: the agent loop is the Converse API with
# toolConfig. The live test suite passes on Kimi K2.5 and on Nova Pro.
# Check what YOUR region exposes with: uv run python scripts/preflight.py
BEDROCK_MODEL_ID=moonshotai.kimi-k2.5
BEDROCK_SMALL_MODEL_ID=apac.amazon.nova-lite-v1:0
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024

# Storage ---------------------------------------------------------------
# NO_AWS=1 keeps every store in memory, so only Bedrock needs credentials.
# Set it to 0 and run scripts/bootstrap_aws.py to use DynamoDB and S3.
NO_AWS=1
DDB_CHECKPOINT_TABLE=mcb-checkpoints
DDB_RESOLVER_TABLE=mcb-resolver
DDB_PROFILE_TABLE=mcb-profiles
DDB_AUDIT_TABLE=mcb-audit
S3_BUCKET=mcb-artifacts-CHANGE-ME

# Behaviour -------------------------------------------------------------
SESSION_TTL_DAYS=30
RESOLVER_TTL_DAYS=180
AUDIT_TTL_DAYS=2555
MSG_HISTORY_TO_KEEP=12
PROMPT_VERSION=v0.3

# Retrieval: below the floor the bot refuses and offers a human (KB-5).
RETRIEVAL_K=4
RETRIEVAL_CANDIDATES=12
RETRIEVAL_FLOOR=0.30
RERANK_WITH_LLM=0

# RS-3: the intent model is the last resort before asking, and fails closed.
INTENT_MODEL_ENABLED=1

# CO-4: the mock core behaves like a core - latency, pending states, a 429.
CORE_LATENCY_MS=120
CORE_CHAOS=1

# 1 = run the whole pipeline against a scripted stub LLM (no Bedrock, no creds).
MOCK_LLM=0
LOG_LEVEL=INFO
